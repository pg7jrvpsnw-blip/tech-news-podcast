# Claude API（通过 mify/PPIO 走，详见 ~/.claude/projects/.../memory/reference_mify_pricing.md）
# 也可以直接用 Anthropic 官方 key（去掉 ANTHROPIC_BASE_URL 即可）
ANTHROPIC_API_KEY=sk-xxx
ANTHROPIC_BASE_URL=https://api.mify.ai/v1   # mify 用户填这里;直连 Anthropic 留空
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI（仅用于 TTS）
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=                              # 留空走官方,如果用代理填代理地址
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=shimmer

# 播客元信息（写进 RSS feed）
PODCAST_TITLE=每日科技速读
PODCAST_AUTHOR=AI 主播
PODCAST_EMAIL=you@example.com
PODCAST_DESCRIPTION=每天 5 分钟,听完昨天最重要的科技新闻。AI 总结播报,中英文一手信息。
PODCAST_SITE_URL=https://your.pages.dev
PODCAST_LANGUAGE=zh-cn

# 阶段 2 才需要(R2 上传),阶段 1 留空
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=tech-news-podcast
R2_PUBLIC_BASE=                               # 例: https://audio.your-domain.com
